{
  "name": "commerce-ops-mcp",
  "version": "1.0.0",
  "description": "AI-native commerce operations MCP server for investigating and resolving order issues",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "cross-env TRANSPORT=http tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "cross-env TRANSPORT=http node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "db:setup": "pnpm run db:push && tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [
    "mcp",
    "commerce",
    "operations",
    "ai",
    "claude"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",

    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {

    "@types/node": "^26.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
