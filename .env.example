
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Transport mode: "stdio" (default, for Claude Desktop) or "http" (for hosted/remote)
TRANSPORT=stdio

# HTTP server settings (only required when TRANSPORT=http)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Integration tests use the same DATABASE_URL.
# WARNING: Integration tests truncate all tables before each test.
# Do NOT point this at a production database.

# HOSTED MCP URL for smoke check 
MCP_HOSTED_URL=